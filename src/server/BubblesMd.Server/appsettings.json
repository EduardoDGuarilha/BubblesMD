{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bubbles": {
    "Provider": "openrouter",
    "MaxOutputTokens": 8000,
    "TimeoutSeconds": 90,
    "Modes": {
      "fast": { "Label": "Fast", "Model": "anthropic/claude-haiku-5.5", "InputPerMillion": 0.10, "OutputPerMillion": 0.50 },
      "smart": { "Label": "Smart", "Model": "anthropic/claude-sonnet-5.5", "InputPerMillion": 2.00, "OutputPerMillion": 10.00 }
    }
  }
}
